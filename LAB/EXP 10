import matplotlib.pyplot as plt

# Monthly sales data
months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun']
sales = [50000, 62000, 58000, 70000, 68000, 75000]

# Line plot
plt.figure(figsize=(8, 5))
plt.plot(months, sales, marker='o', linewidth=2)
plt.title('Monthly Sales Data - Line Plot')
plt.xlabel('Month')
plt.ylabel('Sales (₹)')
plt.grid(True)
plt.show()

# Bar plot
plt.figure(figsize=(8, 5))
plt.bar(months, sales)
plt.title('Monthly Sales Data - Bar Plot')
plt.xlabel('Month')
plt.ylabel('Sales (₹)')
plt.show()
